config PROSPECTOR_LAYER_ROLLER_ALL_CAPS
    bool "Convert layer names to all caps"
    default n

config PROSPECTOR_BATTERY_SWAP
    bool "Swap the battery cells (show slot 1 on the left)"
    default n
    help
      Split slot 0 is the half that was paired first. Enable this when that is the right half,
      so the left cell shows the left half.

config PROSPECTOR_LAYER_ROLLER_HIDE_UNNAMED
    bool "Hide layers without a display-name from the layer display"
    default n
    help
      Layers with no (or an empty) display-name are never shown; while one is active the
      display shows the highest active named layer beneath it. Useful for helper
      layers such as home-row-mod layers that would otherwise flash by while typing.

config PROSPECTOR_LAYER_FADE_MS
    int "Layer name cross-fade time in milliseconds (0 = instant)"
    default 150
    range 0 1000

config PROSPECTOR_ROTATE_DISPLAY_180
    bool "Rotate the display 180 degrees"
    default n

config PROSPECTOR_USE_AMBIENT_LIGHT_SENSOR
    bool "Use ambient light sensor for auto brightness"
    default y

config PROSPECTOR_FIXED_BRIGHTNESS
    int "Fixed display brightness"
    default 50
    range 1 100
    depends on !PROSPECTOR_USE_AMBIENT_LIGHT_SENSOR